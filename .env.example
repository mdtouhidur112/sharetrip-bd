# =========================================================================
# TRAVEL AGENCY ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Copy this file to '.env' and provide your real project credentials.
# =========================================================================

# -------------------------------------------------------------------------
# 1. Admin Authentication Credentials
# -------------------------------------------------------------------------
# CAUTION: Any variable with 'VITE_' prefix is bundled into client-side JS.
# For maximum production security, use Firebase/Supabase Auth role assignment.
admin_user_name=your_admin_username
admin_pass=your_secure_password
VITE_ADMIN_USER_NAME=your_admin_username
VITE_ADMIN_PASS=your_secure_password

# -------------------------------------------------------------------------
# 2. Firebase Configuration & Secret Keys
# Obtain from: Firebase Console -> Project Settings -> General -> Your apps
# -------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# -------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database & Storage Configuration
# Obtain from: Supabase Dashboard -> Project Settings -> API
# -------------------------------------------------------------------------
# Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# IMPORTANT SECURITY NOTE:
# Provide ONLY the public 'anon' key here (starts with eyJhbGci...).
# NEVER expose your 'service_role' secret key in client-side code / VITE_ variables!
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Project Identifiers (Optional for tracking)
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PROJECT_NAME=your_project_name
